# Šablona prostředí pro lab-agenta. `make run-dev` ji zkopíruje jako .env
# a hodnoty dosadí — .env je generovaný, a proto v gitu není.

# Lab agent — doplněno automaticky make run-dev
LAB_USER=
LAB_DOMAIN=
BRANCH_NAME=
DOMAIN=

# Vlastní proměnné projekt nemá: web je statický, build vzniká na hostu
# (`make build`) a nginx v kontejneru jen servíruje hotové dist/. Žádná
# databáze, žádné heslo ani token.
